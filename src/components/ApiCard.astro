---
interface Props {
	title: string;
	type?: 'class' | 'interface' | 'annotation' | 'method' | 'field';
	description?: string;
	link?: string;
	platforms?: ('paper' | 'velocity' | 'fabric' | 'all')[];
	experimental?: boolean;
}

const { title, type = 'class', description, link, platforms, experimental } = Astro.props;

const typeIcons = {
	class: '📦',
	interface: '🔌',
	annotation: '🏷️',
	method: '⚙️',
	field: '📝',
};

const typeColors = {
	class: '#3b82f6',
	interface: '#8b5cf6',
	annotation: '#ec4899',
	method: '#10b981',
	field: '#f59e0b',
};
---

<a href={link} class={`api-card api-card-${type}`} style={`--type-color: ${typeColors[type]}`}>
	<div class="api-card-header">
		<span class="api-type-icon">{typeIcons[type]}</span>
		<div class="api-card-title-group">
			<h3 class="api-card-title">{title}</h3>
			<span class="api-card-type">{type}</span>
		</div>
		{experimental && (
			<span class="experimental-tag">🧪</span>
		)}
	</div>
	{description && <p class="api-card-description">{description}</p>}
	{platforms && (
		<div class="api-card-platforms">
			{platforms.map((p) => (
				<span class="platform-mini">{p}</span>
			))}
		</div>
	)}
	<div class="api-card-arrow">→</div>
</a>

<style>
	.api-card {
		position: relative;
		display: block;
		padding: 1.25rem;
		border-radius: 0.75rem;
		background: var(--sl-color-bg-nav);
		border: 2px solid color-mix(in srgb, var(--type-color) 30%, transparent);
		text-decoration: none;
		transition: all 0.2s ease;
		overflow: hidden;
	}

	.api-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 100%;
		background: var(--type-color);
	}

	.api-card:hover {
		border-color: var(--type-color);
		transform: translateY(-2px);
		box-shadow: 0 8px 16px color-mix(in srgb, var(--type-color) 25%, transparent);
	}

	.api-card:hover .api-card-arrow {
		transform: translateX(4px);
	}

	.api-card-header {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.api-type-icon {
		font-size: 1.5rem;
		line-height: 1;
	}

	.api-card-title-group {
		flex: 1;
		min-width: 0;
	}

	.api-card-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sl-color-text);
		margin: 0 0 0.25rem 0;
		word-break: break-word;
	}

	.api-card-type {
		display: inline-block;
		padding: 0.125rem 0.5rem;
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--type-color) 15%, transparent);
		color: var(--type-color);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.experimental-tag {
		font-size: 1.25rem;
	}

	.api-card-description {
		color: var(--sl-color-text-secondary);
		font-size: 0.9375rem;
		line-height: 1.5;
		margin: 0 0 0.75rem 0;
	}

	.api-card-platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 0.75rem;
	}

	.platform-mini {
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text-accent);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.api-card-arrow {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		font-size: 1.25rem;
		color: var(--type-color);
		transition: transform 0.2s ease;
	}
</style>
