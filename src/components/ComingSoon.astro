---
interface Props {
	message?: string;
	type?: 'coming-soon' | 'wip' | 'experimental' | 'deprecated';
}

const { message, type = 'coming-soon' } = Astro.props;

const icons = {
	'coming-soon': '🚧',
	'wip': '⚠️',
	'experimental': '🧪',
	'deprecated': '⛔',
};

const labels = {
	'coming-soon': 'Coming Soon',
	'wip': 'Work in Progress',
	'experimental': 'Experimental',
	'deprecated': 'Deprecated',
};

const colors = {
	'coming-soon': '#fbbf24',
	'wip': '#fb923c',
	'experimental': '#a78bfa',
	'deprecated': '#ef4444',
};
---

<div class={`status-badge status-${type}`} style={`--badge-color: ${colors[type]}`}>
	<span class="status-icon">{icons[type]}</span>
	<span class="status-label">{labels[type]}</span>
	{message && <span class="status-message">: {message}</span>}
</div>

<style>
	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		background-color: color-mix(in srgb, var(--badge-color) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--badge-color) 40%, transparent);
		font-size: 0.875rem;
		font-weight: 500;
		margin: 1rem 0;
	}

	.status-icon {
		font-size: 1.25rem;
	}

	.status-label {
		color: var(--badge-color);
		font-weight: 600;
	}

	.status-message {
		color: var(--sl-color-text);
	}

	/* Dark mode adjustments */
	:global(.theme-dark) .status-badge {
		background-color: color-mix(in srgb, var(--badge-color) 20%, transparent);
		border-color: color-mix(in srgb, var(--badge-color) 50%, transparent);
	}
</style>
